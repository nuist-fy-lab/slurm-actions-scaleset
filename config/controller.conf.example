REGISTRATION_URL='https://github.com/nuist-fy-lab/satellite-data'
SCALE_SET_NAME='c2ln1-p1shr'
MAX_RUNNERS='4'
PARTITION='p1shr'
CPUS='4'
MEMORY='8G'
TIME_LIMIT='00:30:00'
POOL_MODE='false'
POOL_TIME_LIMIT='3-00:00:00'
POOL_SCRIPT="$HOME/.local/lib/slurm-actions-scaleset/pool-worker.sh"
RUNNER_ARCHIVE="$HOME/.cache/github-actions-runner/actions-runner-linux-x64-2.338.0.tar.gz"
RUNNER_SCRIPT="$HOME/.local/lib/slurm-actions-scaleset/compute-runner.sh"
STATE_DIR="$HOME/.local/state/slurm-actions-scaleset"
HEARTBEAT_FILE="$STATE_DIR/heartbeat"
LOG_FORMAT='json'
WATCHDOG_SERVICE='slurm-actions-scaleset.service'
WATCHDOG_HEARTBEAT_MAX_AGE='120'
SLURM_JOB_PREFIX='ghss-c2ln1-p1shr-'
