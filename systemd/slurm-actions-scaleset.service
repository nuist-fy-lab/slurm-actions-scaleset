[Unit]
Description=GitHub Actions Runner Scale Set Slurm adapter
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/slurm-actions-scaleset
ExecStartPre=/usr/bin/test -x %h/.local/bin/slurm-actions-scaleset
ExecStartPre=/usr/bin/test -r %h/.cache/github-actions-runner/actions-runner-linux-x64-2.338.0.tar.gz
ExecStartPre=/usr/bin/test -x %h/.local/lib/slurm-actions-scaleset/compute-runner.sh
ExecStart=%h/.local/bin/github-egress-run %h/.local/bin/slurm-actions-scaleset \
  --url https://github.com/nuist-fy-lab/satellite-data \
  --name c2ln1-p1shr \
  --max-runners 4 \
  --partition p1shr \
  --cpus 40 \
  --memory 16G \
  --state-dir %h/.local/state/slurm-actions-scaleset \
  --heartbeat-file %h/.local/state/slurm-actions-scaleset/heartbeat \
  --runner-archive %h/.cache/github-actions-runner/actions-runner-linux-x64-2.338.0.tar.gz \
  --runner-script %h/.local/lib/slurm-actions-scaleset/compute-runner.sh \
  --log-format json
Restart=always
RestartSec=5
KillMode=process
TimeoutStopSec=30
Nice=10
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
StandardOutput=file:%h/.local/state/slurm-actions-scaleset/controller.log
StandardError=file:%h/.local/state/slurm-actions-scaleset/controller.err

[Install]
WantedBy=default.target
