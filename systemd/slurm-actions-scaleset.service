[Unit]
Description=GitHub Actions Runner Scale Set Slurm adapter
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=%h/.local/bin/github-egress-run %h/.local/bin/slurm-actions-scaleset \
  --url https://github.com/nuist-fy-lab/satellite-data \
  --name c2ln1-p1shr \
  --max-runners 4 \
  --partition p1shr \
  --cpus 40 \
  --memory 16G
Restart=always
RestartSec=5
KillMode=process
TimeoutStopSec=30
Nice=10
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
