[Unit]
Description=GitHub Actions Runner Scale Set Slurm adapter
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/slurm-actions-scaleset
ExecStartPre=/usr/bin/test -x %h/.local/bin/slurm-actions-scaleset
ExecStartPre=/usr/bin/test -x %h/.local/bin/gost
ExecStartPre=/usr/bin/test -r %h/.config/slurm-actions-scaleset/controller.conf
ExecStartPre=/usr/bin/test -r %h/.config/slurm-actions-scaleset/runtime.conf
ExecStartPre=/usr/bin/test -x %h/.local/lib/slurm-actions-scaleset/compute-runner.sh
ExecStart=%h/.local/lib/slurm-actions-scaleset/start-controller.sh
Restart=always
RestartSec=5
KillMode=process
TimeoutStopSec=30
Nice=10
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
StandardOutput=file:%h/.local/state/slurm-actions-scaleset/controller.log
StandardError=file:%h/.local/state/slurm-actions-scaleset/controller.err

[Install]
WantedBy=default.target
